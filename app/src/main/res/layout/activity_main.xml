<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown only when offline mode has nothing on disk to draw. Links straight to the zone
         list rather than quoting a filesystem path at the user. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/overlay_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/overlay_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textColor="@color/on_overlay_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_body"
                android:textColor="@color/on_overlay_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmptyPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_overlay_muted"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyDownload"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/empty_action"
                android:textStyle="bold"
                app:backgroundTint="@color/action_record"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/overlay_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/overlay_chip"
            android:textColor="@color/on_overlay_primary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/idle"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="4dp" />

        <TextView
            android:id="@+id/chipGnss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/overlay_chip"
            android:textColor="@color/on_overlay_secondary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/gnss_idle"
            android:textSize="14sp"
            android:elevation="4dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnTheme"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/overlay_chip"
            android:contentDescription="@string/map_theme"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_theme" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/overlay_chip"
            android:contentDescription="@string/settings"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

        <!-- Coverage hint: the position is known but no installed map contains it. Tapping it
             offers the zone that probably does. -->
        <TextView
            android:id="@+id/chipCoverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/overlay_chip"
            android:elevation="4dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/quality_weak"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/show_panel"
            android:src="@drawable/ic_panel" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCentre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/centre_on_position"
            android:src="@drawable/ic_centre"
            app:fabSize="mini" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/overlay_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/overlay_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Metric" android:layout_weight="1">
                    <TextView style="@style/Metric.Label" android:textColor="@color/on_overlay_secondary" android:text="elapsed" />
                    <TextView android:id="@+id/mElapsed" style="@style/Metric.Value" android:textColor="@color/on_overlay_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout style="@style/Metric" android:layout_weight="1">
                    <TextView style="@style/Metric.Label" android:textColor="@color/on_overlay_secondary" android:text="imu" />
                    <TextView android:id="@+id/mImu" style="@style/Metric.Value" android:textColor="@color/on_overlay_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout style="@style/Metric" android:layout_weight="1">
                    <TextView style="@style/Metric.Label" android:textColor="@color/on_overlay_secondary" android:text="fixes" />
                    <TextView android:id="@+id/mFixes" style="@style/Metric.Value" android:textColor="@color/on_overlay_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout style="@style/Metric" android:layout_weight="1">
                    <TextView style="@style/Metric.Label" android:textColor="@color/on_overlay_secondary" android:text="sats" />
                    <TextView android:id="@+id/mSats" style="@style/Metric.Value" android:textColor="@color/on_overlay_primary" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Metric" android:layout_weight="1.6">
                    <TextView
                        android:id="@+id/lblDrift"
                        style="@style/Metric.Label"
                        android:textColor="@color/on_overlay_secondary"
                        android:text="@string/drift" />

                    <TextView
                        android:id="@+id/mDrift"
                        style="@style/Metric.Value"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_overlay_primary"
                        android:text="—" />

                    <TextView
                        android:id="@+id/mDriftPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_overlay_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/legendGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/swatch_gps"
                        android:gravity="center_vertical"
                        android:text="@string/legend_gps"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/legendSnap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/swatch_snap"
                        android:gravity="center_vertical"
                        android:text="@string/legend_snap"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/legendImu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/swatch_imu"
                        android:gravity="center_vertical"
                        android:text="@string/legend_imu"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_overlay_muted"
                android:textSize="14sp" />

            <!-- The only on-screen proof that the along-road pipeline has a map to work with. -->
            <TextView
                android:id="@+id/tvMatchSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_overlay_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="@string/start"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/action_record" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFreeRun"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="@string/free_run"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/overlay_stroke_strong"
                android:textColor="@color/on_overlay_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
