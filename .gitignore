# Android / Gradle
*.iml
.gradle/
build/
/local.properties
/.idea/
/captures
.externalNativeBuild
.cxx
.kotlin/
.DS_Store

# Python
__pycache__/
*.pyc

# Third-party papers: kept locally for reference, not redistributed from a
# public repo. The team's own execution plan is the exception.
research/*.pdf
!research/IDR_Hackathon_Execution_Plan_v3.pdf

# Large data files
extracted_sessions/
dataset/
ml_model/data_raw/

# Offline map archives are hundreds of MB; side-load them instead.
# See README: adb push eastern-zone.map .../files/osmdroid/
*.map

# Derived training artefacts and sweep checkpoints
ml_model/dataset_iovnbd*.pt
ml_model/dataset_iovnbd*_meta.json
ml_model/model_data*.pth
ml_model/model_kin*.pth
ml_model/model_cen*.pth

# TCN sweep artefacts. The one checkpoint worth tracking is the current best, which is
# committed explicitly by name (see the negation below) because it is what
# ml_model/export_model.py turns into the shipped asset; everything else here is an
# ablation that build_dataset + train_iovnbd reproduce from the zips in dataset/.
ml_model/model_tcn_*.pth
!ml_model/model_tcn_base_fx.pth
ml_model/train_sweep.log
ml_model/train_iovnbd_results_s*.json
ml_model/seed*.log

# Sweep artefacts: derived datasets (~34 MB each), per-config logs and result files.
# All regenerable from dataset/IO-VNBD_original via eval/iovnbd.py and
# ml_model/build_dataset_iovnbd.py. Patterns deliberately require the underscore so
# they do not match the tracked ml_model/dataset.pt.
ml_model/dataset_*.pt
ml_model/dataset_*_meta.json
ml_model/*.log
ml_model/train_iovnbd_results_*.json
